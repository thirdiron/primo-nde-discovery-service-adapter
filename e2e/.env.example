# Copy this file to e2e/.env (gitignored) and fill in the values.
# Paste URLs here rather than on the command line: zsh adds backslashes to pasted URLs.

# A Primo NDE full-record page for an article with a DOI, on a view whose add-on
# configuration includes LibKey. Open the record in a browser and copy the address bar.
E2E_RECORD_URL="https://sandbox01-na.primo.exlibrisgroup.com/nde/fulldisplay?vid=01COLSCHL_INST:LIBKEY_NDE_E2E_TEST&lang=en&docid=cdi_pubmedcentral_primary_oai_pubmedcentral_nih_gov_5099763"
